# --- Server ---
PORT=3000
TIMEZONE=Australia/Melbourne
# Public https origin of the deployed app (no trailing slash). The Oura redirect
# URI is this + /oauth/oura/callback and must be registered with Oura exactly.
PUBLIC_BASE_URL=https://training-plan.fly.dev

# --- Database (its own Supabase project, separate from HOME_ASSIST) ---
# Project Settings → Database → Connection string → URI ("Session pooler" or
# direct — not "Transaction pooler"). All tables live in the `coach` schema.
DATABASE_URL=postgres://postgres:password@host:5432/postgres

# --- Secrets you generate ---
# Guards admin endpoints (Oura connect, manual sync): openssl rand -hex 20
ADMIN_SECRET=
# Encrypts OAuth tokens at rest: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Intervals.icu ---
# intervals.icu → Settings → Developer Settings → API Key
INTERVALS_API_KEY=
# "0" = the athlete who owns the key (you). Only change if you know you need to.
INTERVALS_ATHLETE_ID=0

# --- Oura (single-user OAuth app) ---
# Create at https://cloud.ouraring.com/oauth/applications (or the newer Oura
# developer portal it points to), with
# redirect URI = $PUBLIC_BASE_URL/oauth/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
